        "status": { "type": "string", "enum": ["open", "closed"] }
      },
      "additionalProperties": false
    },
    "http": {
      "method": "GET",
      "path": "/api/tickets",
      "queryParams": ["status"]
    }
  },
  {
    "name": "create_ticket",
