HOST=0.0.0.0
PORT=3100
MCP_PATH=/mcp
GATEWAY_PUBLIC_URL=https://mcp-gateway.example.com

# Must match the bot's GATEWAY_ACTOR_* settings.
ACTOR_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ACTOR_TOKEN_ISSUER=rocket-mcp-bot
ACTOR_TOKEN_AUDIENCE=https://mcp-gateway.example.com/mcp
ACTOR_TOKEN_CLOCK_SKEW_SECONDS=30

# Your application and its delegated token-exchange endpoint.
APPLICATION_API_BASE_URL=https://application.example.com
APPLICATION_TOKEN_EXCHANGE_URL=https://application.example.com/api/auth/mcp-token
APPLICATION_GATEWAY_TOKEN=replace-with-gateway-service-token
APPLICATION_TIMEOUT_MS=30000

TOOLS_MANIFEST_PATH=./config/tools.json
USER_LINKS_PATH=./config/user-links.json
MAX_API_RESPONSE_CHARS=20000
