# HTTP server
PORT=3000
HOST=0.0.0.0
TRUST_PROXY_HOPS=0
WEBHOOK_PATH=/webhooks/rocketchat
MAX_WEBHOOK_BODY_BYTES=1000000
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=60
LOG_LEVEL=info

# Rocket.Chat outgoing webhook verification and bot identity
ROCKETCHAT_URL=https://chat.example.com
ROCKETCHAT_WEBHOOK_TOKEN=replace-with-the-outgoing-webhook-token
ROCKETCHAT_BOT_USERNAME=assistant-bot
ROCKETCHAT_USER_ID=replace-with-bot-user-id
ROCKETCHAT_AUTH_TOKEN=replace-with-bot-personal-access-token
ROCKETCHAT_REPLY_IN_THREAD=true
ROCKETCHAT_REQUIRE_MENTION=true
ROCKETCHAT_TENANT_ID=default

# Optional authorization boundaries. Empty means any room/user delivered by the
# Rocket.Chat integration is accepted.
ROCKETCHAT_ALLOWED_ROOM_IDS=
ROCKETCHAT_ALLOWED_USER_IDS=

# Model provider: qwen, kimi, or custom. All use OpenAI-compatible Chat Completions.
MODEL_PROVIDER=qwen
MODEL_API_KEY=replace-with-model-api-key
MODEL_NAME=qwen-plus
# Qwen: use the OpenAI-compatible URL for your Alibaba Cloud region/workspace.
# Kimi: omit this variable to use https://api.moonshot.ai/v1.
MODEL_BASE_URL=https://your-workspace.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
MODEL_TIMEOUT_MS=120000

# Remote MCP server (Streamable HTTP)
MCP_URL=https://your-application.example.com/mcp
MCP_AUTH_MODE=actor-jwt
GATEWAY_ACTOR_SECRET=replace-with-at-least-32-random-bytes
GATEWAY_ACTOR_ISSUER=rocket-mcp-bot
GATEWAY_ACTOR_AUDIENCE=https://mcp-gateway.example.com/mcp
# Used only when MCP_AUTH_MODE=static
MCP_BEARER_TOKEN=
# Extra headers as JSON, for example: {"X-Tenant-ID":"tenant-123"}
MCP_HEADERS_JSON={}
MCP_PROTOCOL_VERSION=2025-11-25
MCP_TIMEOUT_MS=120000

# Tool safety. Production default is allow-list. Patterns support * and ?.
# Example: get_*,list_*,search_*,create_ticket
MCP_TOOL_POLICY=allow-list
MCP_TOOL_ALLOWLIST=get_*,list_*,search_*
MAX_TOOL_ITERATIONS=6
MAX_TOOL_RESULT_CHARS=12000

# Optional extra behavior appended to the built-in system prompt.
SYSTEM_PROMPT=
