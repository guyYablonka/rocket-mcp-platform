{
  "name": "rocket-mcp-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "TypeScript Rocket.Chat bot bridge for MCP applications",
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file=.env --watch --import tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "helmet": "8.3.0",
    "jose": "6.2.4",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "ws": "^8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.9",
    "@types/supertest": "7.2.1",
    "@types/ws": "^8.18.1",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
